rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return [
        "hello@nesthelperwa.com",
        "nesthelperwa@gmail.com"
      ];
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in adminEmails();
    }

    match /serviceRequests/{docId} {
      allow create: if false; // public submissions should go through Next.js API route
      allow read, update, delete: if isAdmin();
    }

    match /helperApplications/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /partnerApplications/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /contactMessages/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /referralLinks/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /referralRewards/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /customerCredits/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Launch Rewards are created and enforced only through trusted Next.js server routes.
    // Admin users may review and update records, but public clients cannot read or write them directly.
    match /launchRewardParticipants/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardIdentityLocks/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardEmailVerifications/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardRateLimits/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardSpins/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardSpinRequests/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardParticipantMonths/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardGrandPrizeMonths/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewards/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /smartLabelBatches/{docId} {
      allow create: if false; // generated through admin API route only
      allow read, update, delete: if isAdmin();
    }

    match /smartLabels/{docId} {
      allow create: if false; // generated through admin API route only
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
