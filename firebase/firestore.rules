rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return [
        "hello@nesthelperwa.com",
        "nesthelperwa@gmail.com"
      ];
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in adminEmails();
    }

    function isOwner(ownerUid) {
      return signedIn() && ownerUid is string && request.auth.uid == ownerUid;
    }

    match /serviceRequests/{docId} {
      allow create: if false; // public submissions should go through Next.js API route
      allow read, update, delete: if isAdmin();
    }

    match /helperApplications/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /partnerApplications/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /contactMessages/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /referralLinks/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /referralRewards/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /customerCredits/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /launchRewardParticipants/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardIdentityLocks/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardEmailVerifications/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardRateLimits/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardSpins/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardSpinRequests/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardParticipantMonths/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewardGrandPrizeMonths/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /launchRewards/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /smartLabelBatches/{docId} {
      allow create: if false; // generated through admin API route only
      allow read, update, delete: if isAdmin();
    }

    match /smartLabelReservations/{docId} {
      allow create, delete: if false;
      allow read, update: if isAdmin();
    }

    match /smartLabelPacks/{docId} {
      allow create: if false; // generated through admin API route only
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);
      allow update, delete: if isAdmin();
    }

    match /smartLabelCollections/{docId} {
      allow create: if false; // created through trusted API route only
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);
      allow update: if isAdmin() || (
        isOwner(resource.data.ownerUid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerEmail == resource.data.ownerEmail
      );
      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    match /smartLabels/{docId} {
      allow create: if false; // generated through trusted API route only
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);
      allow update: if isAdmin() || (
        isOwner(resource.data.ownerUid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.claimedFromPackId == resource.data.claimedFromPackId
      );
      allow delete: if isAdmin();
    }

    match /smartLabelFinderMessages/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
